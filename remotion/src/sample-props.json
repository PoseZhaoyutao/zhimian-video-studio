    {
      "id": "definition",
      "startFrame": 350,
      "durationInFrames": 382,
      "endFrame": 732,
      "narration": "先给定义。动态规划是一类通过把原问题拆成重叠子问题、把每个子问题的解存起来避免重复计算、最终用状态转移方程从小到大推出全局最优解的算法范式。",
      "onScreenText": "DP = 拆问题 + 存解 + 推最优",
      "caption": "三个关键字：拆、存、推。",
      "visualType": "pathflow",
      "visualPayload": {
