    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "remotion": "4.0.479",
    "typescript": "6.0.3",
    "zod": "4.3.6"
  }
}
